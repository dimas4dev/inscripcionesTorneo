# ─────────────────────────────────────────────────────────────────
# Firebase Configuration — Torneo Ágape 2026
# Copia este archivo como .env.local y completa con tus valores.
# Encuéntralos en: Firebase Console → Configuración del proyecto → Tus apps → SDK
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:...

# ─────────────────────────────────────────────────────────────────
# Cloudinary — Almacenamiento de comprobantes de pago (GRATIS)
# Crea tu cuenta en cloudinary.com (plan Free: 25 GB)
# 1. Ve a Settings → Upload → Upload presets → Add upload preset
# 2. Signing mode: Unsigned  |  Folder: torneo-agape-2026/comprobantes
# 3. Copia el Preset name y tu Cloud name (Dashboard → Product Environment)
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=torneo_agape
